# MI-Navigator Backend - PRODUCTION Environment Template
#
# SECURITY NOTICE: This is a TEMPLATE file for production deployment.
# DO NOT commit actual secrets to version control.
# Copy this file to .env.production and fill in real values.

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME="MI-Navigator"
APP_ENV=production
DEBUG=false

# CRITICAL: Generate secure random keys (32+ characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_SECURE_64_CHARACTER_SECRET_KEY_PRODUCTION
JWT_SECRET_KEY=CHANGE_ME_TO_SECURE_64_CHARACTER_JWT_SECRET_KEY_PRODUCTION

# API Configuration
API_V1_PREFIX=/api/v1

# ============================================================================
# DATABASE - PRODUCTION
# ============================================================================
# Use managed PostgreSQL service (AWS RDS, Azure Database, Google Cloud SQL)
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
ASYNC_DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# REDIS - PRODUCTION
# ============================================================================
# Use managed Redis service (AWS ElastiCache, Azure Cache, Google Memorystore)
REDIS_URL=redis://REDIS_HOST:6379/0
REDIS_PASSWORD=REDIS_PASSWORD_IF_REQUIRED

# Redis connection settings
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ============================================================================
# LLM API KEYS - PRODUCTION
# ============================================================================
# OpenAI (GPT-4, GPT-4.5, o3) - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# Anthropic Claude (Claude 4, Claude 3.5) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_ANTHROPIC_API_KEY_HERE

# Google Gemini (Gemini 2.5) - https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Default LLM provider (openai, anthropic, or gemini)
LLM_PROVIDER=openai

# LLM Rate Limiting
LLM_MAX_REQUESTS_PER_MINUTE=60
LLM_MAX_TOKENS_PER_REQUEST=4000
LLM_TIMEOUT_SECONDS=30

# ============================================================================
# JWT CONFIGURATION - PRODUCTION
# ============================================================================
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# CORS - PRODUCTION DOMAINS
# ============================================================================
# Add your production frontend URLs
CORS_ORIGINS=["https://app.mi-navigator.com","https://www.mi-navigator.com"]

# ============================================================================
# EMAIL / SMTP - PRODUCTION
# ============================================================================
# Production email service (SendGrid, AWS SES, Mailgun, etc.)
SMTP_HOST=smtp.production-email-service.com
SMTP_PORT=587
SMTP_USER=production-smtp-user
SMTP_PASSWORD=PRODUCTION_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@mi-navigator.com
SMTP_FROM_NAME=MI Navigator
FRONTEND_URL=https://app.mi-navigator.com

# Email configuration
EMAIL_TEMPLATES_DIR=app/templates/email
EMAIL_RATE_LIMIT=100  # Max emails per hour

# ============================================================================
# EXTERNAL APIs - PRODUCTION
# ============================================================================
# Web Scraping APIs
FIRECRAWL_API_KEY=fc-YOUR_FIRECRAWL_API_KEY
JINA_API_KEY=jina_YOUR_JINA_API_KEY
SERPERDEV_API_KEY=YOUR_SERPERDEV_API_KEY

# Optional Analytics APIs
SIMILARWEB_API_KEY=YOUR_SIMILARWEB_KEY_IF_USED
SERPAPI_KEY=YOUR_SERPAPI_KEY_IF_USED
PROXYCURL_API_KEY=YOUR_PROXYCURL_KEY_IF_USED

# ============================================================================
# MONITORING & LOGGING - PRODUCTION
# ============================================================================
# Sentry for error tracking
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/mi-navigator/app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# ============================================================================
# PERFORMANCE & SCALING - PRODUCTION
# ============================================================================
# Worker configuration
WORKERS=4  # Number of Uvicorn workers
WORKER_TIMEOUT=120
KEEPALIVE=5

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Caching
CACHE_TTL=3600  # 1 hour default cache
CACHE_ENABLED=true

# ============================================================================
# SECURITY - PRODUCTION
# ============================================================================
# Security headers
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Session security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# IP Whitelist (optional - comma-separated)
ALLOWED_IPS=

# ============================================================================
# MAINTENANCE MODE
# ============================================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is undergoing scheduled maintenance. We will be back online shortly."
MAINTENANCE_ETA="2 hours"

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================
# Backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=mi-navigator-backups-production
BACKUP_S3_REGION=eu-central-1

# ============================================================================
# FEATURE FLAGS - PRODUCTION
# ============================================================================
# Enable/disable features without code deployment
FEATURE_ANALYTICS_DASHBOARD=true
FEATURE_PREDICTIVE_ANALYTICS=false
FEATURE_API_GATEWAY=false
FEATURE_MULTI_AGENT_WORKFLOWS=true

# ============================================================================
# COMPLIANCE & AUDIT
# ============================================================================
# GDPR compliance
GDPR_ENABLED=true
DATA_RETENTION_DAYS=730  # 2 years
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years

# ============================================================================
# INFRASTRUCTURE
# ============================================================================
# Cloud provider (aws, azure, gcp, on-premise)
CLOUD_PROVIDER=aws
REGION=eu-central-1

# Container orchestration
KUBERNETES_ENABLED=false
DOCKER_SWARM_ENABLED=false

# CDN Configuration
CDN_ENABLED=false
CDN_URL=https://cdn.mi-navigator.com

# ============================================================================
# HEALTH CHECKS & READINESS
# ============================================================================
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live
