# MI-Navigator Backend - STAGING Environment Template
#
# SECURITY NOTICE: This is a TEMPLATE file for staging deployment.
# Copy this file to .env.staging and fill in real values.

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME="MI-Navigator Staging"
APP_ENV=staging
DEBUG=false

# Generate secure random keys (32+ characters)
SECRET_KEY=CHANGE_ME_TO_SECURE_64_CHARACTER_SECRET_KEY_STAGING
JWT_SECRET_KEY=CHANGE_ME_TO_SECURE_64_CHARACTER_JWT_SECRET_KEY_STAGING

# API Configuration
API_V1_PREFIX=/api/v1

# ============================================================================
# DATABASE - STAGING
# ============================================================================
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME_staging
ASYNC_DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME_staging

# Database connection pool (smaller than production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# REDIS - STAGING
# ============================================================================
REDIS_URL=redis://REDIS_HOST:6379/1
REDIS_PASSWORD=REDIS_PASSWORD_IF_REQUIRED

# ============================================================================
# LLM API KEYS - STAGING (can use same as production or test keys)
# ============================================================================
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_ANTHROPIC_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_PROVIDER=openai

# Staging rate limits (more restrictive)
LLM_MAX_REQUESTS_PER_MINUTE=30
LLM_MAX_TOKENS_PER_REQUEST=4000
LLM_TIMEOUT_SECONDS=30

# ============================================================================
# JWT CONFIGURATION - STAGING
# ============================================================================
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# CORS - STAGING DOMAINS
# ============================================================================
CORS_ORIGINS=["https://staging.mi-navigator.com","http://localhost:3000"]

# ============================================================================
# EMAIL / SMTP - STAGING
# ============================================================================
# Use test email service or same as production with staging prefix
SMTP_HOST=smtp.staging-email-service.com
SMTP_PORT=587
SMTP_USER=staging-smtp-user
SMTP_PASSWORD=STAGING_SMTP_PASSWORD
SMTP_FROM_EMAIL=staging@mi-navigator.com
SMTP_FROM_NAME=MI Navigator Staging
FRONTEND_URL=https://staging.mi-navigator.com

EMAIL_TEMPLATES_DIR=app/templates/email
EMAIL_RATE_LIMIT=50

# ============================================================================
# EXTERNAL APIs - STAGING
# ============================================================================
# Can use same keys as production or test keys with lower quotas
FIRECRAWL_API_KEY=fc-YOUR_FIRECRAWL_API_KEY
JINA_API_KEY=jina_YOUR_JINA_API_KEY
SERPERDEV_API_KEY=YOUR_SERPERDEV_API_KEY
SIMILARWEB_API_KEY=
SERPAPI_KEY=
PROXYCURL_API_KEY=

# ============================================================================
# MONITORING & LOGGING - STAGING
# ============================================================================
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1.0  # 100% sampling for staging
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Logging (more verbose than production)
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=/var/log/mi-navigator/staging.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=14

# ============================================================================
# PERFORMANCE & SCALING - STAGING
# ============================================================================
WORKERS=2  # Fewer workers than production
WORKER_TIMEOUT=120
KEEPALIVE=5

# Rate limiting (more restrictive)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=50
RATE_LIMIT_BURST=10

# Caching
CACHE_TTL=1800  # 30 minutes
CACHE_ENABLED=true

# ============================================================================
# SECURITY - STAGING
# ============================================================================
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false  # Disable for staging testing
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
ALLOWED_IPS=

# ============================================================================
# MAINTENANCE MODE
# ============================================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Staging environment is undergoing maintenance."
MAINTENANCE_ETA="1 hour"

# ============================================================================
# BACKUP - STAGING
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * 0"  # Weekly on Sunday at 3 AM
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=mi-navigator-backups-staging
BACKUP_S3_REGION=eu-central-1

# ============================================================================
# FEATURE FLAGS - STAGING (test all new features here first)
# ============================================================================
FEATURE_ANALYTICS_DASHBOARD=true
FEATURE_PREDICTIVE_ANALYTICS=true
FEATURE_API_GATEWAY=true
FEATURE_MULTI_AGENT_WORKFLOWS=true

# ============================================================================
# COMPLIANCE & AUDIT
# ============================================================================
GDPR_ENABLED=true
DATA_RETENTION_DAYS=90
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# ============================================================================
# INFRASTRUCTURE
# ============================================================================
CLOUD_PROVIDER=aws
REGION=eu-central-1
KUBERNETES_ENABLED=false
DOCKER_SWARM_ENABLED=false
CDN_ENABLED=false

# ============================================================================
# HEALTH CHECKS
# ============================================================================
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live
