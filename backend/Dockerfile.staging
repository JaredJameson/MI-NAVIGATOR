# ============================================================================
# MI-Navigator Backend - Staging Dockerfile
# ============================================================================
#
# Staging environment with development tools for debugging
#
# Build: docker build -f Dockerfile.staging -t mi-navigator-backend:staging .
# Run: docker run -p 8000:8000 --env-file .env.staging mi-navigator-backend:staging

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_ENV=staging

# Install dependencies (including dev tools for staging)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    postgresql-client \
    libpq-dev \
    curl \
    vim \
    iputils-ping \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r minavigator && useradd -r -g minavigator minavigator

# Set working directory
WORKDIR /app

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Install additional debugging tools for staging
RUN pip install --no-cache-dir \
    ipython \
    ipdb \
    pytest-watch

# Copy application code
COPY --chown=minavigator:minavigator . .

# Create necessary directories
RUN mkdir -p /var/log/mi-navigator /app/uploads && \
    chown -R minavigator:minavigator /var/log/mi-navigator /app/uploads

# Switch to non-root user
USER minavigator

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run with auto-reload for staging (easier debugging)
CMD alembic upgrade head && \
    uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 2 \
    --log-level debug \
    --access-log \
    --reload \
    --proxy-headers \
    --forwarded-allow-ips='*'
